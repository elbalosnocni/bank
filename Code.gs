function setupSheets(){const ss=getSpreadsheet_();Object.entries(HEADERS).forEach(([name,headers])=>{let sh=ss.getSheetByName(name);if(!sh)sh=ss.insertSheet(name);const width=Math.max(sh.getLastColumn(),headers.length,1),old=sh.getRange(1,1,1,width).getValues()[0];headers.forEach((h,i)=>{if(!old[i])sh.getRange(1,i+1).setValue(h);else if(String(old[i]).trim()!==h)throw new Error('Sai tiêu đề cột '+(i+1)+' trong '+name+'. Mong đợi '+h+'. Không tự ghi đè dữ liệu.');});sh.setFrozenRows(1);sh.getRange(1,1,1,headers.length).setFontWeight('bold').setBackground('#d9eaf7')});const sh=ss.getSheetByName(SHEETS.CONFIG);sh.getRange('C:D').setNumberFormat('dd/MM/yyyy HH:mm');ss.getSheetByName(SHEETS.RESULTS).getRange('A:A').setNumberFormat('dd/MM/yyyy HH:mm:ss');ss.getSheetByName(SHEETS.FEEDBACK).getRange('A:A').setNumberFormat('dd/MM/yyyy HH:mm:ss');ensureCccdSecret_();return 'Đã tạo/cập nhật cấu trúc V7: thêm cột CCCD_Hash (mã băm) và sheet PhanQuyenDe. Dữ liệu cũ được giữ nguyên.'}
