  const structured=rawAns&&typeof rawAns==='object';const hasStructured=structured?(Array.isArray(rawAns)?rawAns.length>0:Object.keys(rawAns).some(k=>k!=='__noOpinion'&&(Array.isArray(rawAns[k])?rawAns[k].length>0:String(rawAns[k]??'').trim()!==''))):!!answer;const isEmpty=!hasStructured;
