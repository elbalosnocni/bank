function adminImportEmployees_(tsv){const lines=String(tsv||'').split(/\r?\n/).filter(x=>x.trim());if(!lines.length)throw new Error('Chưa có dữ liệu nhân viên.');let start=0;if(/^(maNhanVien|ma nhan vien)$/i.test(lines[0].split('\t')[0].trim()))start=1;const sh=getSheetOrThrow_(SHEETS.EMPLOYEES),old=rows_(SHEETS.EMPLOYEES,7),map=new Map(old.map((r,i)=>[String(r[0]).trim(),i+2])),append=[],seen=new Set();let updated=0,errors=[];lines.slice(start).forEach((line,i)=>{const c=line.split('\t');if(c.length<5||!String(c[0]||'').trim()||!String(c[1]||'').trim()){errors.push('Dòng '+(i+start+1)+': cần Mã nhân viên, Họ tên, Bộ phận, Phòng ban, Chức vụ');return}const row=[String(c[0]).trim(),String(c[1]).trim(),String(c[2]||'').trim(),String(c[3]||'').trim(),String(c[4]||'').trim(),String(c[5]||'').trim(),String(c[6]||'ACTIVE').trim()];if(seen.has(row[0])){errors.push('Dòng '+(i+start+1)+': mã nhân viên bị lặp trong dữ liệu nhập');return}seen.add(row[0]);if(map.has(row[0])){sh.getRange(map.get(row[0]),1,1,7).setValues([row]);updated++}else{append.push(row);map.set(row[0],-1)}});if(append.length)sh.getRange(sh.getLastRow()+1,1,append.length,7).setValues(append);return {status:'success',inserted:append.length,updated,errors:errors.slice(0,30),message:'Đã nhập '+append.length+' nhân viên mới, cập nhật '+updated+' nhân viên.'}}
