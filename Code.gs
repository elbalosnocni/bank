function adminGetFeedbackGroups_(p){const all=rows_(SHEETS.FEEDBACK,14),f=String(p.monHoc||'').toLowerCase(),bp=String(p.boPhan||'').toLowerCase(),pb=String(p.phongBan||'').toLowerCase(),cv=String(p.chucVu||'').toLowerCase(),nv=String(p.maNhanVien||'').toLowerCase(),person=String(p.tenNguoiTraLoi||'').toLowerCase(),cat=String(p.phanLoai||'').toLowerCase(),field=String(p.tenTruong||'').toLowerCase(),facets={boPhan:unique_(all.map(r=>r[9])),phongBan:unique_(all.map(r=>r[10])),chucVu:unique_(all.map(r=>r[11])),phanLoai:unique_(all.map(r=>r[12])),tenTruong:unique_(all.map(r=>r[13]))};const data=all.filter(r=>(!f||String(r[2]).toLowerCase()===f)&&(!bp||String(r[9]).toLowerCase()===bp)&&(!pb||String(r[10]).toLowerCase()===pb)&&(!cv||String(r[11]).toLowerCase()===cv)&&(!nv||String(r[8]).toLowerCase()===nv)&&(!person||String(r[1]).toLowerCase().includes(person))&&(!cat||String(r[12]).toLowerCase()===cat)&&(!field||String(r[13]).toLowerCase()===field)&&String(r[7]||'').trim());const free=data.filter(r=>['ESSAY','FILL_BLANK','MULTI_FIELD'].includes(String(r[5]).toUpperCase())||String(r[3]).toUpperCase()==='OPINION');const groups=[];free.forEach(r=>{const text=String(r[7]).trim(),tokens=tokenize_(text);if(!tokens.length)return;let best=null,bestScore=0;groups.forEach(g=>{if(String(g.category||'').toLowerCase()!==String(r[12]||'').toLowerCase()||String(g.field||'').toLowerCase()!==String(r[13]||'').toLowerCase())return;const score=jaccard_(tokens,g.tokens);if(score>bestScore){bestScore=score;best=g}});if(best&&bestScore>=0.32){best.items.push(r);tokens.forEach(t=>best.tokens.add(t))}else groups.push({tokens:new Set(tokens),items:[r],category:String(r[12]||''),field:String(r[13]||'')})});groups.sort((a,b)=>b.items.length-a.items.length);return {status:'success',groups:groups.map((g,i)=>({id:i+1,category:g.category,field:g.field,topic:g.items[0][7].slice(0,140),count:g.items.length,answers:g.items.slice(0,100).map(r=>({time:formatDateTime_(r[0]),name:String(r[1]),subject:String(r