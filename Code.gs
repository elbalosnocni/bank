function adminImportEmployees_(tsv){const lines=String(tsv||'').split(/\r?\n/).filter(x=>x.trim());if(!lines.length)throw new Error('Chưa có dữ liệu nhân viên.');let start=0;if(/^(maNhanVien|ma nhan vien)$/i.test(lines[0].split('\t')[0].trim()))start=1;const sh=getSheetOrThrow_(SHEETS.EMPLOYEES),old=rows_(SHEETS.EMPLOYEES,8),map=new Map(old.map((r,i)=>[String(r[0]).trim(),{row:i+2,data:r}])),append=[],seen=new Set();let updated=0,errors=[];lines.slice(start).forEach((line,i)=>{const c=line.split('\t');if(c.length<5||!String(c[0]||'').trim()||!String(c[1]||'').trim()){errors.push('Dòng '+(i+start+1)+': cần Mã nhân viên, Họ tên, Bộ phận, Phòng ban, Chức vụ');return}const id=String(c[0]).trim();if(seen.has(id)){errors.push('Dòng '+(i+start+1)+': mã nhân viên bị lặp');return}seen.add(id);let cccdHash='';try{if(String(c[7]||'').trim())cccdHash=hashCccd_(c[7]);}catch(err){errors.push('Dòng '+(i+start+1)+': '+err.message);return}const prior=map.get(id);if(cccdHash&&old.some((r,ix)=>String(r[7]||'')===cccdHash&&String(r[0]||'').trim()!==id)){errors.push('Dòng '+(i+start+1)+': số căn cước đã gắn với nhân viên khác');return}if(cccdHash&&append.some(r=>r[7]===cccdHash)){errors.push('Dòng '+(i+start+1)+': số căn cước bị lặp trong dữ liệu nhập');return}const row=[id,String(c[1]).trim(),String(c[2]||'').trim(),String(c[3]||'').trim(),String(c[4]||'').trim(),String(c[5]||'').trim(),String(c[6]||'ACTIVE').trim(),cccdHash||(prior?String(prior.data[7]||''):'')];if(prior){sh.getRange(prior.row,1,1,8).setValues([row]);updated++}else append.push(row)});if(append.length)sh.getRange(sh.getLastRow()+1,1,append.length,8).setValues(append);return {status:'success',inserted:append.length,updated,errors:errors.slice(0,30),message:'Đã nhập '+append.length+' nhân viên mới, cập nhật '+updated+' nhân viên. Số căn cước chỉ lưu dạng mã băm, không lưu số gốc.'}}
function tokenize_(s){return new Set(String(s).toLocaleLowerCase('vi').normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/đ/g,'d').match(/[a-z0-9]{3,}/g)||[])}function jaccard_(a,b){const inter=[...a].filter(x=>b.has(x)).length,union=new Set([...a,...b]).size;return union?inter/union:0}
function parseQuestionConfig_(v){try{const x=JSON.parse(String(v||'{}'));if(Array.isArray(x))return {fields:normalizeQuestionFields_(x)};return x&&typeof x==='object'?x:{}}catch(e){return {fields:normalizeQuestionFields_(v)}}}
function serializeQuestionConfig_(type,q){if(type==='MULTI_FIELD'){const fields=normalizeQuestionFields_(q.truongTraLoi);return JSON.stringify({fields,description:String(q.description||''),required:q.required!==false})}const c=q.cauHinh&&typeof q.cauHinh==='object'?q.cauHinh:{};if(type==='SECTION')return JSON.stringify({sectionStyle:String(c.sectionStyle||'TITLE'),description:String(q.description||c.description||''),required:false});const extras={description:String(q.description||c.description||''),required:q.required!==false};if(type==='DROPDOWN')extras.geoType=String(c.geoType||'')==='PROVINCE_WARD'?'PROVINCE_WARD':'';if(Array.isArray(q.options)&&q.options.length>4)extras.options=questionOptions_(q);if(type==='SHORT_TEXT'){extras.inputType=c.inputType==='number'?'number':'text';extras.maxLength=Math.max(1,Math.min(5000,Number(c.maxLength)||500));extras.minValue=c.minValue===''||c.minValue==null?null:Number(c.minValue);extras.maxValue=c.maxValue===''||c.maxValue==null?null:Number(c.maxValue);if(extras.inputType==='number'&&extras.minValue!=null&&extras.maxValue!=null&&extras.maxValue<extras.minValue)throw new Error('Giá trị tối đa phải lớn hơn hoặc bằng giá trị tối thiểu.')}if(['MULTIPLE_CHOICE_GRID','CHECKBOX_GRID'].includes(type)){const rows=Array.isArray(c.rows)?c.rows.map(x=>String(x||'').trim()).filter(Boolean).slice(0,30):[];if(!rows.length)throw new Error('Nhập ít nhất một dòng cho câu hỏi dạng lưới.');extras.rows=rows}if(type==='LINEAR_SCALE'||type==='RATING'){const min=type==='RATING'?1:Math.max(0,Math.min(9,Number(c.min??1))),max=type==='RATING'?Math.max(3,Math.min(10,Number(c.max??5))):Math.max(min+1,Math.min(10,Number(c.max??5)));Object.assign(extras,{min,max,minLabel:String(c.minLabel||''),maxLabel:String(c.maxLabel||'')})}return JSON.stringify(extras)}
function normalizeQuestionFields_(v){if(v&&typeof v==='object'&&!Array.isArray(v))return [];if(Array.isArray(v))return v.map(x=>typeof x==='string'?{label:x.trim().replace(/^\*\s*/,''),required:/^\*/.test(x.trim())}:{label:String(x.label||'').trim(),required:!!x.required}).filter(x=>x.label).slice(0,20);const s=String(v||'').trim();if(!s)return [];try{const j=JSON.parse(s);if(Array.isArray(j))return normalizeQuestionFields_(j)}catch(e){}return s.split(/[\n|;]/).map(x=>x.trim()).filter(Boolean).slice(0,20).map(raw=>({label:raw.replace(/^\*\s*/,''),required:/^\*/.test(raw)}))}
function parseQuestionFields_(v){try{const x=JSON.parse(String(v||''));if(x&&Array.isArray(x.fields))return normalizeQuestionFields_(x.fields)}catch(e){}return normalizeQuestionFields_(v)}
function parseAdminDate_(v){if(!v)return null;const m=String(v).match(/^(\d{4})-(\d\d)-(\d\d)T(\d\d):(\d\d)$/);if(!m)throw new Error('Ngày giờ không hợp lệ.');return new Date(+m[1],+m[2]-1,+m[3],+m[4],+m[5])}function formatDateTime_(v){if(!v)return '';const d=v instanceof Date?v:new Date(v);return isNaN(d)?String(v):Utilities.formatDate(d,Session.getScriptTimeZone(),'dd/MM/yyyy HH:mm')}
