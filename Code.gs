 const name=directory.hoTen,emp=directory,answers=p.answers||{},feedbackSh=getSheetOrThrow_(SHEETS.FEEDBACK),feedbackRows=[];let score=0,scorable=0;const errors=[];
 Object.keys(s.answerKey).forEach(id=>{
