/** HE THONG THI/KHAO SAT V5 - Spreadsheet ID */
const SPREADSHEET_ID = "DAN_ID_GOOGLE_SHEET_CUA_BAN_VAO_DAY";
function getSpreadsheet_(){const id=String(SPREADSHEET_ID||'').trim();if(!id||id.includes('DAN_ID_'))throw new Error('Chưa cấu hình SPREADSHEET_ID.');try{return SpreadsheetApp.openById(id)}catch(e){throw new Error('Không mở được Google Sheet. Kiểm tra ID và quyền truy cập: '+e.message)}}
const SHEETS={CONFIG:'CaiDatDeThi',BANK:'NganHangDe',RESULTS:'KetQua',FEEDBACK:'PhanHoi'};
const HEADERS={CaiDatDeThi:['MonHoc','ThoiGianLamBai','NgayBatDau','NgayKetThuc','SoCauHoiBoc','CheDo','XaoTronCauHoi','XaoTronDapAn'],NganHangDe:['Id','MonHoc','LoaiCauHoi','NoiDungCauHoi','HinhAnh','DapAnA','DapAnB','DapAnC','DapAnD','HinhAnhA','HinhAnhB','HinhAnhC','HinhAnhD','DapAnDung'],KetQua:['ThoiGian','TenHocSinh','MonHoc','SoCauDung','TongSoCau','DiemSo'],PhanHoi:['ThoiGian','TenNguoiTraLoi','MonHoc','CheDo','IdCauHoi','LoaiCauHoi','NoiDungCauHoi','NoiDungTraLoi']};
const SESSION_PREFIX='EXAM_SESSION_',SUBMITTED_PREFIX='EXAM_SUBMITTED_',ADMIN_TOKEN_PREFIX='EXAM_ADMIN_',ADMIN_TOKEN_TTL=21600;
function doGet(e){try{const a=e?.parameter?.action||'';if(a==='getSubjects')return jsonOutput_({status:'success',subjects:getSubjects_()});if(a==='getExam')return jsonOutput_(createExam_(String(e.parameter.monHoc||'').trim()));return jsonOutput_({status:'error',message:'Thao tác không hợp lệ.'})}catch(err){console.error(err);return jsonOutput_({status:'error',message:err.message||'Lỗi máy chủ.'})}}
function doPost(e){try{const p=JSON.parse(e?.postData?.contents||'{}');if(p.action==='submitExam')return jsonOutput_(submitExam_(p));if(p.action==='adminLogin')return jsonOutput_(adminLogin_(p));if(String(p.action||'').startsWith('admin')){requireAdmin_(p.token);return jsonOutput_(handleAdminAction_(p))}return jsonOutput_({status:'error',message:'Thao tác không hợp lệ.'})}catch(err){console.error(err);return jsonOutput_({status:'error',message:err.message||'Không thể xử lý dữ liệu.'})}}
function setupSheets(){const ss=getSpreadsheet_();Object.entries(HEADERS).forEach(([name,headers])=>{let sh=ss.getSheetByName(name);if(!sh)sh=ss.insertSheet(name);const old=sh.getRange(1,1,1,Math.max(sh.getLastColumn(),headers.length)).getValues()[0];headers.forEach((h,i)=>{if(!old[i])sh.getRange(1,i+1).setValue(h);else if(String(old[i]).trim()!==h)throw new Error('Sai tiêu đề cột '+(i+1)+' trong '+name+'. Mong đợi '+h+'. Không tự ghi đè dữ liệu.');});sh.setFrozenRows(1);sh.getRange(1,1,1,headers.length).setFontWeight('bold').setBackground('#d9eaf7')});const sh=ss.getSheetByName(SHEETS.CONFIG);sh.getRange('C:D').setNumberFormat('dd/MM/yyyy HH:mm');ss.getSheetByName(SHEETS.RESULTS).getRange('A:A').setNumberFormat('dd/MM/yyyy HH:mm:ss');ss.getSheetByName(SHEETS.FEEDBACK).getRange('A:A').setNumberFormat('dd/MM/yyyy HH:mm:ss');return 'Đã tạo/cập nhật cấu trúc V5. Dữ liệu cũ được giữ nguyên.'}
function getSheetOrThrow_(n){const s=getSpreadsheet_().getSheetByName(n);if(!s)throw new Error('Thiếu trang tính '+n+'. Hãy chạy setupSheets().');return s}
function rows_(name,cols){const s=getSheetOrThrow_(name);return s.getLastRow()>1?s.getRange(2,1,s.getLastRow()-1,cols).getValues():[]}
function getSubjects_(){return rows_(SHEETS.CONFIG,8).filter(r=>String(r[0]||'').trim()).map(r=>String(r[0]).trim())}
function bool_(v){return v===true||String(v).toLowerCase()==='true'||String(v)==='1'||String(v).toUpperCase()==='YES'}
function createExam_(subject){if(!subject)return {status:'error',message:'Vui lòng chọn môn học.'};const cfg=rows_(SHEETS.CONFIG,8).find(r=>String(r[0]||'').trim().toLowerCase()===subject.toLowerCase());if(!cfg)return {status:'error',message:'Không tìm thấy môn học.'};const forced=getExamStatusMap_()[String(cfg[0]).trim()];if(forced==='CLOSED')return {status:'error',message:'Đề hiện đang đóng.'};const now=new Date(),start=parseSheetDate_(cfg[2]),end=parseSheetDate_(cfg[3]);if(forced!=='OPEN'&&((start&&now<start)||(end&&now>end)))return {status:'error',message:start&&now<start?'Đề chưa đến giờ mở.':'Đề đã hết hạn.'};let qs=rows_(SHEETS.BANK,14).filter(r=>String(r[1]||'').trim().toLowerCase()===subject.toLowerCase()&&String(r[0]||'').trim()&&String(r[3]||'').trim());if(!qs.length)return {status:'error',message:'Ngân hàng câu hỏi đang trống.'};const mode=String(cfg[5]||'GRADED').toUpperCase()==='OPINION'?'OPINION':'GRADED',shuffleQ=bool_(cfg[6]),shuffleO=bool_(cfg[7]);if(shuffleQ)shuffle_(qs);const n=Number(cfg[4])||qs.length;qs=qs.slice(0,Math.min(qs.length,n>0?n:qs.length));const key={},publicQs=qs.map(r=>{const id=String(r[0]).trim(),type=String(r[2]||'MULTIPLE_CHOICE').toUpperCase();let opts=[['A',r[5],r[9]],['B',r[6],r[10]],['C',r[7],r[11]],['D',r[8],r[12]]].filter(x=>String(x[1]||'').trim()||String(x[2]||'').trim());if(type==='TRUE_FALSE')opts=[['A','Đúng',''],['B','Sai','']];if(shuffleO&&['MULTIPLE_CHOICE','MULTI_SELECT','TRUE_FALSE'].includes(type)){shuffle_(opts);const letters=['A','B','C','D'];opts=opts.map((o,i)=>[letters[i],o[1],o[2]]);}
let answer=String(r[13]||'').trim();if(shuffleO&&['MULTIPLE_CHOICE','MULTI_SELECT','TRUE_FALSE'].includes(type)){const original=[['A',r[5],r[9]],['B',r[6],r[10]],['C',r[7],r[11]],['D',r[8],r[12]]];if(type==='TRUE_FALSE')original.splice(0,4,['A','Đúng',''],['B','Sai','']);const wanted=answer.toUpperCase().split(/[;,| ]+/).filter(Boolean);answer=opts.filter(o=>{const old=original.find(x=>String(x[1])===String(o[1])&&String(x[2]||'')===String(o[2]||''));return old&&wanted.includes(old[0])}).map(o=>o[0]).join(',');}
key[id]={type,answer};return {id,type,question:String(r[3]),image:safeImageUrl_(r[4]),options:opts.map(o=>({value:o[0],text:String(o[1]||''),image:safeImageUrl_(o[2])}))};});const token=Utilities.getUuid();const session={subject:String(cfg[0]),mode,answerKey:key,total:publicQs.length,createdAt:Date.now()};CacheService.getScriptCache().put(SESSION_PREFIX+token,JSON.stringify(session),21600);return {status:'success',token,config:{thoiGian:Number(cfg[1])||0,monHoc:String(cfg[0]),mode},questions:publicQs}}
function submitExam_(p){const token=String(p.token||''),cache=CacheService.getScriptCache(),sk=SESSION_PREFIX+token,dk=SUBMITTED_PREFIX+token;if(!token||cache.get(dk))return {status:'error',message:'Mã phiên không hợp lệ hoặc bài đã nộp.'};const raw=cache.get(sk);if(!raw)return {status:'error',message:'Phiên làm bài hết hạn. Vui lòng tải lại.'};const s=JSON.parse(raw),name=String(p.studentName||'').trim().slice(0,150);if(!name)return {status:'error',message:'Vui lòng nhập họ tên.'};const answers=p.answers||{},feedbackSh=getSheetOrThrow_(SHEETS.FEEDBACK),feedbackRows=[];let score=0,scorable=0;Object.keys(s.answerKey).forEach(id=>{const q=s.answerKey[id],rawAns=answers[id],answer=Array.isArray(rawAns)?rawAns.join(','):String(rawAns==null?'':rawAns).trim();if(s.mode==='GRADED'&&!['ESSAY'].includes(q.type)){scorable++;if(compareAnswer_(answer,q.answer,q.type))score++}const meta=(p.questionMeta||{})[id]||{};feedbackRows.push([new Date(),name,s.subject,s.mode,id,q.type,String(meta.question||''),answer])});const lock=LockService.getScriptLock();lock.waitLock(10000);try{if(cache.get(dk))return {status:'error',message:'Bài đã nộp.'};if(feedbackRows.length)feedbackSh.getRange(feedbackSh.getLastRow()+1,1,feedbackRows.length,8).setValues(feedbackRows);let grade=null;if(s.mode==='GRADED'){grade=scorable?Math.round(score/scorable*1000)/100:0;getSheetOrThrow_(SHEETS.RESULTS).appendRow([new Date(),name,s.subject,score,scorable,grade])}cache.put(dk,'1',21600);cache.remove(sk)}finally{lock.releaseLock()}return {status:'success',mode:s.mode,score:s.mode==='GRADED'?score:null,total:s.mode==='GRADED'?scorable:null,diemSo:grade,message:s.mode==='OPINION'?'Cảm ơn bạn đã gửi ý kiến.': 'Đã nộp bài thành công.'}}
function compareAnswer_(a,b,type){const norm=x=>String(x||'').toLocaleLowerCase('vi').trim().replace(/\s+/g,' ');if(type==='MULTI_SELECT')return norm(a).split(/[,;| ]+/).filter(Boolean).sort().join(',')===norm(b).split(/[,;| ]+/).filter(Boolean).sort().join(',');return norm(a).split('|').some(x=>x===norm(b))||norm(b).split('|').some(x=>x===norm(a))}
function safeImageUrl_(v){let s=String(v||'').trim();if(!s)return '';const m=s.match(/drive\.google\.com\/(?:file\/d\/|open\?id=|uc\?.*?id=)([\w-]+)/i)||s.match(/[?&]id=([\w-]+)/);if(m)s='https://drive.google.com/uc?export=view&id='+m[1];return /^https?:\/\/\S+$/i.test(s)?s:''}
function parseSheetDate_(v){if(!v)return null;if(v instanceof Date&&!isNaN(v))return v;const s=String(v).trim(),m=s.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})(?:\s+(\d{1,2}):(\d{2}))?$/);if(!m){const d=new Date(s);return isNaN(d)?null:d}return new Date(+m[3],+m[2]-1,+m[1],+(m[4]||0),+(m[5]||0))}
function shuffle_(a){for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]]}}
function jsonOutput_(o){return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON)}
function setAdminPassword(password){password=String(password||'');if(password.length<10)throw new Error('Mật khẩu tối thiểu 10 ký tự.');const salt=Utilities.getUuid()+Utilities.getUuid(),hash=hashPassword_(password,salt);PropertiesService.getScriptProperties().setProperties({ADMIN_SALT:salt,ADMIN_HASH:hash});return 'Đã thiết lập mật khẩu Admin.'}
function hashPassword_(p,s){return Utilities.base64EncodeWebSafe(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,s+'|'+p,Utilities.Charset.UTF_8))}
function adminLogin_(p){const x=PropertiesService.getScriptProperties(),salt=x.getProperty('ADMIN_SALT'),hash=x.getProperty('ADMIN_HASH');if(!salt||!hash)return {status:'error',message:'Admin chưa được thiết lập mật khẩu.'};if(hashPassword_(String(p.password||''),salt)!==hash)return {status:'error',message:'Mật khẩu không đúng.'};const t=Utilities.getUuid()+Utilities.getUuid();CacheService.getScriptCache().put(ADMIN_TOKEN_PREFIX+t,'1',ADMIN_TOKEN_TTL);return {status:'success',token:t}}
function requireAdmin_(t){if(!t||!CacheService.getScriptCache().get(ADMIN_TOKEN_PREFIX+String(t)))throw new Error('Phiên Admin hết hạn. Hãy đăng nhập lại.')}
function handleAdminAction_(p){switch(p.action){case'adminDashboard':return adminDashboard_();case'adminSaveSubject':return adminSaveSubject_(p);case'adminSetStatus':return adminSetStatus_(p);case'adminAddQuestion':return adminAddQuestion_(p.question||{});case'adminImportQuestions':return adminImportQuestions_(p.tsv||'');case'adminGetResults':return adminGetResults_(p);case'adminGetFeedbackGroups':return adminGetFeedbackGroups_(p);case'adminLogout':CacheService.getScriptCache().remove(ADMIN_TOKEN_PREFIX+String(p.token));return {status:'success'};default:return {status:'error',message:'Lệnh Admin không hợp lệ.'}}}
function adminDashboard_(){const cfg=rows_(SHEETS.CONFIG,8),bank=rows_(SHEETS.BANK,14),map=getExamStatusMap_(),now=new Date();return {status:'success',totalQuestions:bank.length,subjects:cfg.filter(r=>r[0]).map(r=>{const n=String(r[0]),st=parseSheetDate_(r[2]),en=parseSheetDate_(r[3]);let status=map[n]||'AUTO';if(status==='AUTO')status=st&&now<st?'SCHEDULED':en&&now>en?'EXPIRED':'OPEN';return {monHoc:n,thoiGian:+r[1]||0,ngayBatDau:formatDateTime_(r[2]),ngayKetThuc:formatDateTime_(r[3]),soCau:+r[4]||0,mode:String(r[5]||'GRADED'),shuffleQ:bool_(r[6]),shuffleO:bool_(r[7]),status,soCauTrongNganHang:bank.filter(q=>String(q[1]).toLowerCase()===n.toLowerCase()).length}})}}
function adminSaveSubject_(p){const n=String(p.monHoc||'').trim();if(!n)throw new Error('Tên môn học bắt buộc.');const st=parseAdminDate_(p.ngayBatDau),en=parseAdminDate_(p.ngayKetThuc);if(st&&en&&en<st)throw new Error('Ngày kết thúc phải sau ngày bắt đầu.');const row=[n,Math.max(0,+p.thoiGian||0),st||'',en||'',Math.max(0,Math.floor(+p.soCau||0)),p.mode==='OPINION'?'OPINION':'GRADED',!!p.shuffleQ,!!p.shuffleO],sh=getSheetOrThrow_(SHEETS.CONFIG),data=rows_(SHEETS.CONFIG,8),i=data.findIndex(r=>String(r[0]).toLowerCase()===n.toLowerCase());if(i<0)sh.appendRow(row);else sh.getRange(i+2,1,1,8).setValues([row]);return {status:'success',message:i<0?'Đã thêm môn/cấu hình.':'Đã cập nhật cấu hình.'}}
function adminSetStatus_(p){const n=String(p.monHoc||''),s=String(p.status||'').toUpperCase();if(!['OPEN','CLOSED','AUTO'].includes(s)||!getSubjects_().includes(n))throw new Error('Môn học hoặc trạng thái không hợp lệ.');const m=getExamStatusMap_();if(s==='AUTO')delete m[n];else m[n]=s;PropertiesService.getScriptProperties().setProperty('EXAM_STATUS_MAP',JSON.stringify(m));return {status:'success',message:'Đã cập nhật trạng thái.'}}
function getExamStatusMap_(){try{return JSON.parse(PropertiesService.getScriptProperties().getProperty('EXAM_STATUS_MAP')||'{}')}catch(e){return {}}}
function adminAddQuestion_(q){const id=String(q.id||'').trim(),sub=String(q.monHoc||'').trim(),type=String(q.loaiCauHoi||'').toUpperCase(),content=String(q.noiDungCauHoi||'').trim();const types=['MULTIPLE_CHOICE','MULTI_SELECT','TRUE_FALSE','FILL_BLANK','ESSAY'];if(!id||!sub||!content||!types.includes(type))throw new Error('Thiếu ID, môn, nội dung hoặc loại câu hỏi không hợp lệ.');if(!getSubjects_().some(x=>x.toLowerCase()===sub.toLowerCase()))throw new Error('Môn học chưa được tạo.');const options=[q.dapAnA,q.dapAnB,q.dapAnC,q.dapAnD],correct=String(q.dapAnDung||'').trim(),cfg=rows_(SHEETS.CONFIG,8).find(r=>String(r[0]).toLowerCase()===sub.toLowerCase()),graded=String(cfg?.[5]||'GRADED').toUpperCase()!=='OPINION';if(['MULTIPLE_CHOICE','MULTI_SELECT'].includes(type)&&options.filter(x=>String(x||'').trim()).length<2)throw new Error('Cần ít nhất 2 phương án.');if(graded&&type==='MULTIPLE_CHOICE'&&!/^[ABCD]$/i.test(correct))throw new Error('Đáp án đúng phải là A/B/C/D.');if(graded&&type==='MULTI_SELECT'&&!/^[ABCD](?:[,;| ]+[ABCD])*$/i.test(correct))throw new Error('Nhập đáp án đúng dạng A,C.');if(graded&&type==='TRUE_FALSE'&&!/^[AB]$/i.test(correct))throw new Error('Đúng/Sai: đáp án A hoặc B.');if(graded&&type==='FILL_BLANK'&&!correct)throw new Error('Cần đáp án điền khuyết.');const sh=getSheetOrThrow_(SHEETS.BANK),d=rows_(SHEETS.BANK,14);if(d.some(r=>String(r[0])===id))throw new Error('ID đã tồn tại.');sh.appendRow([id,sub,type,content,safeImageUrl_(q.hinhAnh),...options.map(x=>String(x||'')),...['hinhAnhA','hinhAnhB','hinhAnhC','hinhAnhD'].map(k=>safeImageUrl_(q[k])),correct]);return {status:'success',message:'Đã thêm câu hỏi.'}}
function adminImportQuestions_(tsv){const lines=String(tsv||'').split(/\r?\n/).filter(x=>x.trim());if(!lines.length)throw new Error('Chưa có dữ liệu.');let start=0;if(/^id\s*$/i.test(lines[0].split('\t')[0]))start=1;const sh=getSheetOrThrow_(SHEETS.BANK),existing=new Set(rows_(SHEETS.BANK,14).map(r=>String(r[0]))),subjects=rows_(SHEETS.CONFIG,8),out=[],errors=[];for(let i=start;i<lines.length;i++){const c=lines[i].split('\t');if(c.length<10){errors.push('Dòng '+(i+1)+': cần ít nhất 10 cột');continue}const [id,sub,type0,content,img,a,b,cc,d]=c,type=String(type0||'').toUpperCase(),cfg=subjects.find(r=>String(r[0]).toLowerCase()===String(sub).toLowerCase()),graded=String(cfg?.[5]||'GRADED').toUpperCase()!=='OPINION',correct=String(c[13]||c[9]||'').trim();if(!id||existing.has(id)||!cfg||!['MULTIPLE_CHOICE','MULTI_SELECT','TRUE_FALSE','FILL_BLANK','ESSAY'].includes(type)||!String(content||'').trim()){errors.push('Dòng '+(i+1)+': ID trùng/thiếu, môn chưa tạo, loại hoặc nội dung không hợp lệ');continue}if(graded&&type==='MULTIPLE_CHOICE'&&!/^[ABCD]$/i.test(correct)){errors.push('Dòng '+(i+1)+': đáp án trắc nghiệm phải A/B/C/D');continue}if(graded&&type==='MULTI_SELECT'&&!/^[ABCD](?:[,;| ]+[ABCD])*$/i.test(correct)){errors.push('Dòng '+(i+1)+': đáp án nhiều lựa chọn ví dụ A,C');continue}const has14=c.length>=14;const row=[id,sub,type,content,safeImageUrl_(img),a||'',b||'',cc||'',d||'',safeImageUrl_(has14?c[9]:''),safeImageUrl_(has14?c[10]:''),safeImageUrl_(has14?c[11]:''),safeImageUrl_(has14?c[12]:''),correct];out.push(row);existing.add(id)}if(out.length)sh.getRange(sh.getLastRow()+1,1,out.length,14).setValues(out);return {status:'success',imported:out.length,errors:errors.slice(0,40),message:'Đã nhập '+out.length+' câu hỏi.'}}
function adminGetResults_(p){const data=rows_(SHEETS.RESULTS,6),f=String(p.monHoc||'').toLowerCase();return {status:'success',results:data.filter(r=>!f||String(r[2]).toLowerCase()===f).reverse().slice(0,1000).map(r=>({thoiGian:formatDateTime_(r[0]),tenHocSinh:String(r[1]),monHoc:String(r[2]),soCauDung:+r[3]||0,tongSoCau:+r[4]||0,diemSo:+r[5]||0}))}}
function adminGetFeedbackGroups_(p){const f=String(p.monHoc||'').toLowerCase(),data=rows_(SHEETS.FEEDBACK,8).filter(r=>(!f||String(r[2]).toLowerCase()===f)&&String(r[7]||'').trim());const free=data.filter(r=>['ESSAY','FILL_BLANK'].includes(String(r[5]).toUpperCase())||String(r[3]).toUpperCase()==='OPINION');const groups=[];free.forEach(r=>{const text=String(r[7]).trim(),tokens=tokenize_(text);if(!tokens.length)return;let best=null,bestScore=0;groups.forEach(g=>{const score=jaccard_(tokens,g.tokens);if(score>bestScore){bestScore=score;best=g}});if(best&&bestScore>=0.32){best.items.push(r);tokens.forEach(t=>best.tokens.add(t))}else groups.push({tokens:new Set(tokens),items:[r]})});groups.sort((a,b)=>b.items.length-a.items.length);return {status:'success',groups:groups.map((g,i)=>({id:i+1,topic:g.items[0][7].slice(0,140),count:g.items.length,answers:g.items.slice(0,100).map(r=>({time:formatDateTime_(r[0]),name:String(r[1]),subject:String(r[2]),question:String(r[6]),answer:String(r[7])}))})),total:free.length,note:'Nhóm được gợi ý bằng độ tương đồng từ khóa (Jaccard), không phải AI hiểu ngữ nghĩa. Giáo viên cần rà soát.'}}
function tokenize_(s){return new Set(String(s).toLocaleLowerCase('vi').normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/đ/g,'d').match(/[a-z0-9]{3,}/g)||[])}function jaccard_(a,b){const inter=[...a].filter(x=>b.has(x)).length,union=new Set([...a,...b]).size;return union?inter/union:0}
function parseAdminDate_(v){if(!v)return null;const m=String(v).match(/^(\d{4})-(\d\d)-(\d\d)T(\d\d):(\d\d)$/);if(!m)throw new Error('Ngày giờ không hợp lệ.');return new Date(+m[1],+m[2]-1,+m[3],+m[4],+m[5])}function formatDateTime_(v){if(!v)return '';const d=v instanceof Date?v:new Date(v);return isNaN(d)?String(v):Utilities.formatDate(d,Session.getScriptTimeZone(),'dd/MM/yyyy HH:mm')}
