  const addError=message=>errors.push({id,question:question||id,message});
  const makeRow=(answer,field)=>[new Date(),name,s.subject,s.mode,id,q.type,question,String(answer||''),emp.maNhanVien,emp.boPhan,emp.phongBan,emp.chucVu,q.category||'',String(field||'')];
