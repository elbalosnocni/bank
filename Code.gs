function normalizeQuestionFields_(v){if(Array.isArray(v))return v.map(x=>typeof x==='string'?{label:x.trim().replace(/^\*\s*/,''),required:/^\*/.test(x.trim())}:{label:String(x.label||'').trim(),required:!!x.required}).filter(x=>x.label).slice(0,20);const s=String(v||'').trim();if(!s)return [];try{const j=JSON.parse(s);if(Array.isArray(j))return normalizeQuestionFields_(j)}catch(e){}return s.split(/[\n|;]/).map(x=>x.trim()).filter(Boolean).slice(0,20).map(raw=>({label:raw.replace(/^\*\s*/,''),required:/^\*/.test(raw)}))}
