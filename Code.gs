function submitExam_(p){
 const token=String(p.token||''),cache=CacheService.getScriptCache(),sk=SESSION_PREFIX+token,dk=SUBMITTED_PREFIX+token;
 if(!token||cache.get(dk))return {status:'error',message:'Mã phiên không hợp lệ hoặc bài đã nộp.'};
